{
	"nodes":[
		{"id":"g-3","type":"group","x":0,"y":11217,"width":13280,"height":6703,"color":"#7F77DD","label":"03 · Índice y recuperación"},
		{"id":"g-2","type":"group","x":0,"y":4000,"width":8000,"height":6720,"color":"#7F77DD","label":"02 · Ingesta"},
